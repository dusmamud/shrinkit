---
import { t } from "../lib/i18n";
import type { Locale } from "../lib/locale";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
---

<div id="how-it-works">
  {/* Row 1 — doodle left, text right */}
  <section class="bg-[#fafcff] py-[4.375rem]">
    <div
      class="mx-auto flex max-w-[1075px] flex-col items-center gap-10 px-4 min-[1185px]:flex-row min-[1185px]:gap-16"
    >
      <div class="flex w-full justify-center min-[1185px]:w-1/2" aria-hidden="true">
        <svg
          width="300"
          height="240"
          viewBox="0 0 300 240"
          fill="none"
          role="img"
          aria-label="Pixel grid illustration"
        >
          <rect x="30" y="30" width="180" height="180" rx="10" stroke="#1d2939" stroke-width="3" />
          <g stroke="#007bff" stroke-width="2">
            <path d="M90 30v180M150 30v180M30 90h180M30 150h180" />
          </g>
          <rect x="150" y="150" width="60" height="60" fill="#42c3ac" opacity="0.55" />
          <rect x="30" y="30" width="60" height="60" fill="#007bff" opacity="0.25" />
          <path
            d="M30 228h180"
            stroke="#1d2939"
            stroke-width="2"
            stroke-linecap="round"
            stroke-dasharray="1 8"
          />
          <path d="M238 96v48M244 96l-6-9-6 9M244 144l-6 9-6-9" stroke="#1d2939" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
          <path d="M96 238h48M96 232l-9 6 9 6M144 232l9 6-9 6" stroke="#1d2939" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
          <circle cx="262" cy="52" r="16" stroke="#007bff" stroke-width="3" />
          <path d="M256 52h12M262 46v12" stroke="#007bff" stroke-width="3" stroke-linecap="round" />
        </svg>
      </div>
      <div class="w-full min-[1185px]:max-w-[35.625rem]">
        <h3 class="text-[2.5rem] font-normal leading-tight text-black">
          {t(locale, "info1.title")}
        </h3>
        <p class="mt-5 text-[1.0625rem] font-light leading-relaxed text-[#1d2939]">
          {t(locale, "info1.p1")}
        </p>
        <p class="mt-4 text-[1.0625rem] font-light leading-relaxed text-[#1d2939]">
          {t(locale, "info1.p2")}
        </p>
        <p class="mt-4 text-[1.0625rem] font-light leading-relaxed text-[#1d2939]">
          {t(locale, "info1.p3")}
        </p>
      </div>
    </div>
  </section>

  {/* Row 2 — text left, doodle right */}
  <section class="bg-[#fafcff] py-[4.375rem]">
    <div
      class="mx-auto flex max-w-[1075px] flex-col items-center gap-10 px-4 min-[1185px]:flex-row min-[1185px]:gap-16"
    >
      <div class="w-full min-[1185px]:max-w-[35.625rem]">
        <h3 class="text-[2.5rem] font-normal leading-tight text-black">
          {t(locale, "info2.title")}
        </h3>
        <p class="mt-5 text-[1.0625rem] font-light leading-relaxed text-[#1d2939]">
          {t(locale, "info2.p1")}
        </p>
        <p class="mt-4 text-[1.0625rem] font-light leading-relaxed text-[#1d2939]">
          {t(locale, "info2.p2")}
        </p>
        <p class="mt-4 text-[1.0625rem] font-light leading-relaxed text-[#1d2939]">
          {t(locale, "info2.p3")}
        </p>
      </div>
      <div class="flex w-full justify-center min-[1185px]:w-1/2" aria-hidden="true">
        <svg
          width="300"
          height="240"
          viewBox="0 0 300 240"
          fill="none"
          role="img"
          aria-label="Shrinking illustration"
        >
          <rect x="24" y="60" width="120" height="120" rx="10" stroke="#1d2939" stroke-width="3" />
          <g stroke="#007bff" stroke-width="2">
            <path d="M64 60v120M104 60v120M24 100h120M24 140h120" />
          </g>
          <path
            d="M168 118h44m0 0-10-10m10 10-10 10"
            stroke="#42c3ac"
            stroke-width="4"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
          <rect x="228" y="92" width="52" height="52" rx="8" stroke="#1d2939" stroke-width="3" />
          <path d="M241 92v52M254 92v52M228 105h52M228 118h52M228 131h52" stroke="#007bff" stroke-width="1.6" />
          <path
            d="M60 200c14-10 26 6 40-4s26 6 40-4"
            stroke="#42c3ac"
            stroke-width="3"
            stroke-linecap="round"
            stroke-dasharray="1 9"
          />
          <circle cx="252" cy="170" r="14" stroke="#007bff" stroke-width="3" />
          <path d="M246 170l4.5 4.5L259 166" stroke="#007bff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </div>
    </div>
  </section>
</div>
