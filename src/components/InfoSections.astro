---
import { t } from "../lib/i18n";
import type { Locale } from "../lib/locales";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
---

<div id="how-it-works" class="home-info-container info remove-overflow-x bg-[#fafcff] py-[3.125rem] min-[1185px]:py-[4.375rem] mt-5">
  <div class="container-fluid mx-auto px-4">
    <div class="home-info-swiper-container relative">
      <!-- Slides wrapper: horizontal swipe on mobile (<1185px), stacked column on desktop (>=1185px) -->
      <div
        id="info-swiper-wrapper"
        class="swiper-wrapper flex flex-row overflow-x-auto min-[1185px]:overflow-visible min-[1185px]:flex-col snap-x snap-mandatory min-[1185px]:snap-none scroll-smooth [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
      >
        <!-- Slide 1: What is an image file size? -->
        <div class="swiper-slide w-full flex-shrink-0 snap-center min-[1185px]:snap-align-none">
          <div class="home-info-block flex flex-col min-[1185px]:flex-row items-center justify-center max-w-[1075px] mx-auto min-[1185px]:gap-16 mb-0 min-[1185px]:mb-[4.0625rem]">
            <!-- Illustration (on top for mobile, on left for desktop) -->
            <div class="illustration-col flex items-center justify-center w-full min-[1185px]:w-1/2 p-4 min-[1185px]:p-8">
              <img
                src="/Illustration/what-is-file-size-color.svg"
                alt="Illustration showing what an image file size is"
                width="420"
                height="420"
                loading="lazy"
                decoding="async"
                class="h-auto max-h-[240px] min-[600px]:max-h-[300px] min-[1185px]:max-h-[360px] w-auto max-w-full object-contain select-none pointer-events-none"
              />
            </div>

            <!-- Text Content -->
            <div class="text-col flex items-center w-full min-[1185px]:max-w-[35.625rem] px-4 min-[1185px]:px-0">
              <div class="w-[90%] min-[1185px]:w-full mx-auto">
                <h3 class="home-info-section-title text-[1.875rem] min-[700px]:text-[2.5rem] font-normal leading-tight text-black pb-5">
                  {t(locale, "info1.title")}
                </h3>
                <div class="section-paragraph-font text-[1.0625rem] font-light leading-relaxed text-[#1d2939] space-y-4">
                  <p>{t(locale, "info1.p1")}</p>
                  <p>{t(locale, "info1.p2")}</p>
                  <p>{t(locale, "info1.p3")}</p>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Slide 2: How can I reduce my image's file size? -->
        <div class="swiper-slide w-full flex-shrink-0 snap-center min-[1185px]:snap-align-none">
          <div class="home-info-block flex flex-col min-[1185px]:flex-row items-center justify-center max-w-[1075px] mx-auto min-[1185px]:gap-16">
            <!-- Text Content (on bottom for mobile via order-2, on left for desktop via order-1) -->
            <div class="text-col order-2 min-[1185px]:order-1 flex items-center w-full min-[1185px]:max-w-[35.625rem] px-4 min-[1185px]:px-0">
              <div class="w-[90%] min-[1185px]:w-full mx-auto">
                <h3 class="home-info-section-title text-[1.875rem] min-[700px]:text-[2.5rem] font-normal leading-tight text-black pb-5">
                  {t(locale, "info2.title")}
                </h3>
                <div class="section-paragraph-font text-[1.0625rem] font-light leading-relaxed text-[#1d2939] space-y-4">
                  <p>{t(locale, "info2.p1")}</p>
                  <p>{t(locale, "info2.p2")}</p>
                  <p>{t(locale, "info2.p3")}</p>
                </div>
              </div>
            </div>

            <!-- Illustration (on top for mobile via order-1, on right for desktop via order-2) -->
            <div class="illustration-col order-1 min-[1185px]:order-2 flex items-center justify-center w-full min-[1185px]:w-1/2 p-4 min-[1185px]:p-8">
              <img
                src="/Illustration/how-to-reduce-file-size-color.svg"
                alt="Illustration showing how to reduce image file size"
                width="420"
                height="420"
                loading="lazy"
                decoding="async"
                class="h-auto max-h-[240px] min-[600px]:max-h-[300px] min-[1185px]:max-h-[360px] w-auto max-w-full object-contain select-none pointer-events-none"
              />
            </div>
          </div>
        </div>
      </div>

      <!-- Pagination Bullets (Mobile only: <1185px) -->
      <div class="swiper-pagination flex min-[1185px]:hidden justify-center items-center gap-2.5 mt-8" aria-label="Slide pagination">
        <button
          type="button"
          class="swiper-bullet h-[14px] w-[14px] rounded-full bg-[#93b4e6] transition-all cursor-pointer"
          data-slide="0"
          aria-label="Slide 1"
          aria-current="true"
        ></button>
        <button
          type="button"
          class="swiper-bullet h-[14px] w-[14px] rounded-full bg-[#d9e2ef] transition-all cursor-pointer"
          data-slide="1"
          aria-label="Slide 2"
          aria-current="false"
        ></button>
      </div>
    </div>
  </div>
</div>

<script>
  function setupInfoSwiper() {
    const wrapper = document.getElementById("info-swiper-wrapper");
    const bullets = document.querySelectorAll<HTMLButtonElement>(".swiper-bullet");
    if (!wrapper || bullets.length === 0) return;

    bullets.forEach((bullet) => {
      bullet.addEventListener("click", () => {
        const index = Number(bullet.getAttribute("data-slide"));
        const slideWidth = wrapper.clientWidth;
        wrapper.scrollTo({ left: index * slideWidth, behavior: "smooth" });
      });
    });

    wrapper.addEventListener(
      "scroll",
      () => {
        const slideWidth = wrapper.clientWidth;
        if (slideWidth <= 0) return;
        const activeIndex = Math.round(wrapper.scrollLeft / slideWidth);

        bullets.forEach((b, i) => {
          if (i === activeIndex) {
            b.classList.remove("bg-[#d9e2ef]");
            b.classList.add("bg-[#93b4e6]");
            b.setAttribute("aria-current", "true");
          } else {
            b.classList.remove("bg-[#93b4e6]");
            b.classList.add("bg-[#d9e2ef]");
            b.setAttribute("aria-current", "false");
          }
        });
      },
      { passive: true }
    );
  }

  setupInfoSwiper();
  document.addEventListener("astro:page-load", setupInfoSwiper);
</script>
