---
import { t } from "../lib/i18n";
import type { Locale } from "../lib/locale";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

const features = [
  {
    t: t(locale, "features.f1t"),
    d: t(locale, "features.f1d"),
    icon: '<path d="M4 8h16M4 16h16" stroke-width="2.2" stroke-linecap="round"/><path d="m7 5 3 3-3 3M17 13l-3 3 3 3" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" fill="none"/>',
  },
  {
    t: t(locale, "features.f2t"),
    d: t(locale, "features.f2d"),
    icon: '<path d="M12 3l7 3v5c0 4.5-3 8.5-7 10-4-1.5-7-5.5-7-10V6l7-3Z" stroke-width="2" stroke-linejoin="round"/><path d="m9.5 12 2 2 3.5-4" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"/>',
  },
  {
    t: t(locale, "features.f3t"),
    d: t(locale, "features.f3d"),
    icon: '<rect x="3" y="7" width="13" height="10" rx="2" stroke-width="2"/><path d="M16 10.5h2.5A1.5 1.5 0 0 1 20 12v4a1.5 1.5 0 0 1-1.5 1.5H16" stroke-width="2" fill="none"/><circle cx="8.5" cy="12" r="1.4" fill="currentColor" stroke="none"/>',
  },
  {
    t: t(locale, "features.f4t"),
    d: t(locale, "features.f4d"),
    icon: '<path d="M5 12.5a7 7 0 0 1 12.9-2M19 11.5a7 7 0 0 1-12.9 2" stroke-width="2" stroke-linecap="round" fill="none"/><path d="M18 3v4h-4M6 21v-4h4" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>',
  },
];
---

<section class="border-y border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-900/50" aria-label={t(locale, "features.title")}>
  <div class="mx-auto max-w-5xl px-4 py-14">
    <h2 class="text-center text-2xl font-extrabold tracking-tight text-slate-900 md:text-3xl dark:text-white">
      {t(locale, "features.title")}
    </h2>
    <div class="mt-8 grid gap-4 sm:grid-cols-2">
      {features.map((f) => (
        <div class="rounded-2xl border border-slate-200 p-6 dark:border-slate-800 dark:bg-slate-900">
          <span class="inline-flex h-11 w-11 items-center justify-center rounded-xl bg-teal-100 text-teal-700 dark:bg-teal-900/60 dark:text-teal-300">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true" set:html={f.icon} />
          </span>
          <h3 class="mt-3 font-bold text-slate-900 dark:text-white">{f.t}</h3>
          <p class="mt-1.5 text-sm leading-relaxed text-slate-600 dark:text-slate-300">{f.d}</p>
        </div>
      ))}
    </div>
  </div>
</section>
