---
import { t } from "../lib/i18n";
import { localizedPath, type Locale } from "../lib/locale";
import LanguageSwitcher from "./LanguageSwitcher.astro";

interface Props {
  locale: Locale;
  path: string;
}
const { locale, path } = Astro.props;

const home = localizedPath("/", locale);
const links = [
  { href: `${home}#how-it-works`, label: t(locale, "nav.how") },
  { href: localizedPath("/privacy", locale), label: t(locale, "nav.privacy") },
  { href: localizedPath("/contact", locale), label: t(locale, "nav.contact") },
];
---

<header class="bg-[#fafcff]">
  <div class="mx-auto flex max-w-[1075px] items-center justify-between px-4 py-4">
    <a href={home} class="flex items-center gap-2.5" aria-label={t(locale, "site.name")}>
      <svg width="34" height="34" viewBox="0 0 34 34" aria-hidden="true">
        <rect width="34" height="34" rx="7" fill="#007bff"></rect>
        <path
          d="M11 23V11h12"
          stroke="#fff"
          stroke-width="2.6"
          stroke-linecap="round"
          stroke-linejoin="round"
          fill="none"></path>
        <path
          d="M11 11l9.5 9.5"
          stroke="#fff"
          stroke-width="2.6"
          stroke-linecap="round"></path>
        <path
          d="M15.5 20.5h5v-5"
          stroke="#fff"
          stroke-width="2.6"
          stroke-linecap="round"
          stroke-linejoin="round"
          fill="none"></path>
      </svg>
      <span class="text-[1.35rem] font-medium tracking-tight text-black">ShrinkIt</span>
    </a>

    {/* Desktop nav */}
    <nav class="hidden items-center lg:flex" aria-label="Primary">
      {
        links.map((l, i) => (
          <>
            {i > 0 && <span class="mx-4 h-5 w-px bg-[#d7dee9]" aria-hidden="true" />}
            <a
              href={l.href}
              class="text-[14px] font-normal tracking-[1.17px] text-black transition-colors hover:text-[#016df0]"
            >
              {l.label}
            </a>
          </>
        ))
      }
      <a
        href={`${home}#tool`}
        class="ml-8 inline-flex h-[42px] items-center rounded-[6px] bg-[#007bff] px-6 text-[14px] font-bold text-white transition-colors hover:bg-[#0257bf]"
      >
        {t(locale, "nav.resize")}
      </a>
      <span class="ml-4">
        <LanguageSwitcher locale={locale} path={path} />
      </span>
    </nav>

    {/* Mobile hamburger */}
    <div class="flex items-center gap-3 lg:hidden">
      <LanguageSwitcher locale={locale} path={path} />
      <button
        type="button"
        id="nav-open"
        aria-label="Menu"
        class="inline-flex h-10 w-10 items-center justify-center rounded-md text-black"
      >
        <svg width="26" height="26" viewBox="0 0 26 26" fill="none" aria-hidden="true">
          <path d="M4 8h18M4 13h18M4 18h18" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" />
        </svg>
      </button>
    </div>
  </div>
</header>

{/* Full-screen mobile menu */}
<div
  id="mobile-menu"
  class="fixed inset-0 z-[100] hidden flex-col bg-white"
  role="dialog"
  aria-modal="true"
  aria-label="Menu"
>
  <div class="flex items-center justify-between px-4 py-4">
    <span class="text-[1.35rem] font-medium tracking-tight text-black">ShrinkIt</span>
    <button
      type="button"
      id="nav-close"
      aria-label="Close"
      class="inline-flex h-10 w-10 items-center justify-center rounded-md text-black"
    >
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" />
      </svg>
    </button>
  </div>
  <nav class="flex flex-col items-center gap-8 px-6 pt-10" aria-label="Mobile">
    {
      links.map((l) => (
        <a
          href={l.href}
          class="mobile-link text-xl font-normal tracking-[1.17px] text-black transition-colors hover:text-[#016df0]"
        >
          {l.label}
        </a>
      ))
    }
    <a
      href={`${home}#tool`}
      class="mobile-link mt-2 inline-flex h-[48px] items-center rounded-[6px] bg-[#007bff] px-8 text-base font-bold text-white transition-colors hover:bg-[#0257bf]"
    >
      {t(locale, "nav.resize")}
    </a>
  </nav>
</div>

<script is:inline>
  (function () {
    var menu = document.getElementById("mobile-menu");
    var open = document.getElementById("nav-open");
    var close = document.getElementById("nav-close");
    if (!menu || !open || !close) return;
    function show(v) {
      menu.classList.toggle("hidden", !v);
      menu.classList.toggle("flex", v);
      document.body.style.overflow = v ? "hidden" : "";
    }
    open.addEventListener("click", function () {
      show(true);
    });
    close.addEventListener("click", function () {
      show(false);
    });
    menu.querySelectorAll(".mobile-link").forEach(function (a) {
      a.addEventListener("click", function () {
        show(false);
      });
    });
  })();
</script>
