---
import { t } from "../lib/i18n";
import { localizedPath, type Locale } from "../lib/locale";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import ThemeToggle from "./ThemeToggle.astro";

interface Props {
  locale: Locale;
  path: string;
}
const { locale, path } = Astro.props;

const home = localizedPath("/", locale);
const links = [
  { href: localizedPath("/how-it-works", locale), label: t(locale, "nav.how") },
  { href: "/tools", label: t(locale, "nav.tools") },
  { href: localizedPath("/privacy", locale), label: t(locale, "nav.privacy") },
  { href: localizedPath("/contact", locale), label: t(locale, "nav.contact") },
];
---

<header class="bg-tpage border-b border-tdivider/50">
  <div class="mx-auto flex max-w-[1075px] items-center justify-between px-4 py-3.5">
    <a href={home} class="flex items-center gap-2.5 transition-transform hover:scale-[1.02] active:scale-95" aria-label={t(locale, "site.name")}>
      <img
        src="/favicon.svg"
        alt="ShrinkIt"
        width="34"
        height="34"
        class="h-[34px] w-[34px] object-contain"
      />
      <span class="text-[1.35rem] font-medium tracking-tight text-tink">ShrinkIt</span>
    </a>

    {/* Desktop nav */}
    <nav class="hidden items-center lg:flex" aria-label="Primary">
      {
        links.map((l, i) => (
          <>
            {i > 0 && <span class="mx-2.5 xl:mx-4 h-4 w-px bg-tdivider" aria-hidden="true" />}
            <a
              href={l.href}
              class="text-[13px] xl:text-[14px] font-normal tracking-[0.8px] xl:tracking-[1.17px] text-tink transition-colors hover:text-taccent"
            >
              {l.label}
            </a>
          </>
        ))
      }
      <a
        href={localizedPath("/resize", locale)}
        class="ml-4 xl:ml-6 inline-flex h-[38px] xl:h-[40px] items-center rounded-[6px] bg-tbtnb px-4 xl:px-6 text-xs xl:text-[14px] font-bold text-white shadow-sm transition-all hover:bg-[#0257bf] hover:shadow active:scale-95"
      >
        {t(locale, "nav.resize")}
      </a>
      <span class="ml-3 xl:ml-4 inline-flex items-center gap-2">
        <ThemeToggle locale={locale} />
        <LanguageSwitcher locale={locale} path={path} idPrefix="desktop" />
      </span>
    </nav>

    {/* Mobile hamburger — language + theme live inside the menu only */}
    <div class="lg:hidden">
      <button
        type="button"
        id="nav-open"
        aria-label="Menu"
        class="inline-flex h-11 w-11 min-h-[44px] min-w-[44px] items-center justify-center rounded-md text-tink transition hover:bg-thoverbg active:scale-95"
      >
        <svg width="26" height="26" viewBox="0 0 26 26" fill="none" aria-hidden="true">
          <path d="M4 8h18M4 13h18M4 18h18" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" />
        </svg>
      </button>
    </div>
  </div>
</header>

{/* Full-screen mobile menu drawer */}
<div
  id="mobile-menu"
  class="fixed inset-0 z-[100] hidden flex-col bg-tsurface"
  role="dialog"
  aria-modal="true"
  aria-label="Menu"
>
  <div class="flex items-center justify-between px-4 py-4 border-b border-tdivider">
    <a href={home} class="flex items-center gap-2.5" aria-label={t(locale, "site.name")}>
      <img
        src="/favicon.svg"
        alt="ShrinkIt"
        width="30"
        height="30"
        class="h-[30px] w-[30px] object-contain"
      />
      <span class="text-[1.35rem] font-medium tracking-tight text-tink">ShrinkIt</span>
    </a>
    <button
      type="button"
      id="nav-close"
      aria-label="Close"
      class="inline-flex h-11 w-11 min-h-[44px] min-w-[44px] items-center justify-center rounded-md text-tink transition hover:bg-thoverbg active:scale-95"
    >
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" />
      </svg>
    </button>
  </div>
  <nav class="flex flex-col items-center gap-7 px-6 pt-8 pb-10 overflow-y-auto" aria-label="Mobile">
    {
      links.map((l) => (
        <a
          href={l.href}
          class="mobile-link text-xl font-normal tracking-[1.17px] text-tink transition-colors hover:text-taccent"
        >
          {l.label}
        </a>
      ))
    }
    <a
      href={localizedPath("/resize", locale)}
      class="mobile-link mt-2 inline-flex h-[48px] items-center rounded-[6px] bg-tbtnb px-8 text-base font-bold text-white transition-colors hover:bg-[#0257bf]"
    >
      {t(locale, "nav.resize")}
    </a>
    <div class="mt-4 flex flex-col items-center gap-3.5 border-t border-tdivider pt-6 w-full max-w-xs">
      <div class="flex w-full items-center justify-between">
        <span class="text-sm font-medium text-tink">{t(locale, "nav.language")}</span>
        <LanguageSwitcher locale={locale} path={path} idPrefix="mobile" />
      </div>
      <div class="flex w-full items-center justify-between">
        <span class="text-sm font-medium text-tink">{t(locale, "theme.label")}</span>
        <ThemeToggle locale={locale} />
      </div>
    </div>
  </nav>
</div>

<script is:inline>
  (function () {
    // 1. Mobile Menu Open / Close
    var menu = document.getElementById("mobile-menu");
    var open = document.getElementById("nav-open");
    var close = document.getElementById("nav-close");
    if (menu && open && close) {
      function show(v) {
        menu.classList.toggle("hidden", !v);
        menu.classList.toggle("flex", v);
        document.body.style.overflow = v ? "hidden" : "";
      }
      open.addEventListener("click", function () {
        show(true);
      });
      close.addEventListener("click", function () {
        show(false);
      });
      menu.querySelectorAll(".mobile-link").forEach(function (a) {
        a.addEventListener("click", function () {
          show(false);
        });
      });
    }

    // 2. Custom Dropdowns Manager (for both Theme and Language)
    function setupDropdowns() {
      var dropdowns = document.querySelectorAll(".custom-dropdown");

      function closeAllDropdowns() {
        dropdowns.forEach(function (dd) {
          var m = dd.querySelector(".dropdown-menu");
          var btn = dd.querySelector(".dropdown-trigger");
          var ch = dd.querySelector(".dropdown-chevron");
          if (m) m.classList.add("hidden");
          if (btn) btn.setAttribute("aria-expanded", "false");
          if (ch) ch.classList.remove("rotate-180");
        });
      }

      dropdowns.forEach(function (dd) {
        var btn = dd.querySelector(".dropdown-trigger");
        var m = dd.querySelector(".dropdown-menu");
        var ch = dd.querySelector(".dropdown-chevron");
        if (!btn || !m) return;

        if (btn._hasDropdownInit) return;
        btn._hasDropdownInit = true;

        btn.addEventListener("click", function (e) {
          e.stopPropagation();
          var isCurrentlyOpen = !m.classList.contains("hidden");
          closeAllDropdowns();
          if (!isCurrentlyOpen) {
            m.classList.remove("hidden");
            btn.setAttribute("aria-expanded", "true");
            if (ch) ch.classList.add("rotate-180");
          }
        });

        m.addEventListener("click", function (e) {
          e.stopPropagation();
        });
      });

      document.addEventListener("click", function () {
        closeAllDropdowns();
      });

      document.addEventListener("keydown", function (e) {
        if (e.key === "Escape") closeAllDropdowns();
      });
    }

    // 3. Theme Manager (Strictly 2 options: Light and Dark)
    var KEY = "shrinkit-theme";

    function readStoredTheme() {
      try {
        var v = window.localStorage.getItem(KEY);
        if (v === "light" || v === "dark") return v;
        return window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
      } catch (e) {
        return "light";
      }
    }

    function syncThemeUI(theme) {
      document.documentElement.dataset.theme = theme;
      document.documentElement.style.colorScheme = theme;

      // Update meta theme colors
      document.querySelectorAll('meta[name="theme-color"][data-theme-color]').forEach(function (m) {
        m.setAttribute("content", theme === "dark" ? "#121214" : "#007bff");
      });

      // Update all theme toggle buttons across the page:
      // moon icon in light mode (click -> dark), sun icon in dark mode.
      var isDark = theme === "dark";
      document.querySelectorAll("[data-theme-toggle]").forEach(function (btn) {
        var moon = btn.querySelector(".theme-toggle-moon");
        var sun = btn.querySelector(".theme-toggle-sun");
        if (moon) moon.classList.toggle("hidden", isDark);
        if (sun) sun.classList.toggle("hidden", !isDark);
        btn.setAttribute("aria-pressed", isDark ? "true" : "false");
      });
    }

    function setupThemeToggle() {
      document.querySelectorAll("[data-theme-toggle]").forEach(function (btn) {
        if (btn._hasThemeToggle) return;
        btn._hasThemeToggle = true;
        btn.addEventListener("click", function (e) {
          e.stopPropagation();
          var next = readStoredTheme() === "dark" ? "light" : "dark";
          switchTheme(next, btn);
        });
      });
    }

    function switchTheme(newTheme, triggerEl) {
      if (newTheme !== "light" && newTheme !== "dark") newTheme = "light";

      try {
        window.localStorage.setItem(KEY, newTheme);
      } catch (e) {}

      // Close open dropdowns
      var dd = triggerEl ? triggerEl.closest(".custom-dropdown") : null;
      if (dd) {
        var m = dd.querySelector(".dropdown-menu");
        var btn = dd.querySelector(".dropdown-trigger");
        var ch = dd.querySelector(".dropdown-chevron");
        if (m) m.classList.add("hidden");
        if (btn) btn.setAttribute("aria-expanded", "false");
        if (ch) ch.classList.remove("rotate-180");
      }

      if (
        !document.startViewTransition ||
        window.matchMedia("(prefers-reduced-motion: reduce)").matches
      ) {
        syncThemeUI(newTheme);
        return;
      }

      var rect = triggerEl ? triggerEl.getBoundingClientRect() : { left: window.innerWidth / 2, top: 0, width: 0, height: 0 };
      var centerX = rect.left + rect.width / 2;
      var centerY = rect.top + rect.height / 2;
      var maxDistance = Math.hypot(
        Math.max(centerX, window.innerWidth - centerX),
        Math.max(centerY, window.innerHeight - centerY)
      );

      var transition = document.startViewTransition(function () {
        syncThemeUI(newTheme);
      });

      transition.ready.then(function () {
        document.documentElement.animate(
          {
            clipPath: [
              "circle(0px at " + centerX + "px " + centerY + "px)",
              "circle(" + maxDistance + "px at " + centerX + "px " + centerY + "px)",
            ],
          },
          {
            duration: 650,
            easing: "ease-in-out",
            pseudoElement: "::view-transition-new(root)",
          }
        );
      });
    }

    window.addEventListener("storage", function (e) {
      if (e.key === KEY) {
        syncThemeUI(readStoredTheme());
      }
    });

    window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", function (e) {
      try {
        if (!window.localStorage.getItem(KEY)) {
          syncThemeUI(e.matches ? "dark" : "light");
        }
      } catch (err) {}
    });

    setupDropdowns();
    setupThemeToggle();
    syncThemeUI(readStoredTheme());

    document.addEventListener("astro:page-load", function () {
      setupDropdowns();
      setupThemeToggle();
      syncThemeUI(readStoredTheme());
    });
  })();
</script>
