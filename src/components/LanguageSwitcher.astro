---
import { localizedPath, type Locale } from "../lib/locale";
import { locales } from "../lib/locales";

interface Props {
  locale: Locale;
  path: string;
}
const { locale, path } = Astro.props;
---

<label class="relative inline-flex items-center">
  <span class="sr-only">Language</span>
  <select
    data-testid="language-switcher"
    class="cursor-pointer appearance-none rounded-full border border-slate-200 bg-white py-2 pl-3 pr-8 text-xs font-semibold text-slate-600 outline-none transition hover:border-slate-300 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300"
    onchange="window.location.href = this.value"
  >
    {locales.map((l) => (
      <option value={localizedPath(path, l)} selected={l === locale}>
        {l.toUpperCase()}
      </option>
    ))}
  </select>
  <svg
    class="pointer-events-none absolute right-2.5 h-3.5 w-3.5 text-slate-400"
    viewBox="0 0 16 16"
    fill="none"
    aria-hidden="true"
  >
    <path d="m4 6 4 4 4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
</label>
