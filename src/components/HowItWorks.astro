---
import { t } from "../lib/i18n";
import type { Locale } from "../lib/locale";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

const steps = [
  { n: "1", t: t(locale, "how.t1"), d: t(locale, "how.d1") },
  { n: "2", t: t(locale, "how.t2"), d: t(locale, "how.d2") },
  { n: "3", t: t(locale, "how.t3"), d: t(locale, "how.d3") },
];
---

<section class="mx-auto max-w-5xl px-4 py-14" aria-label={t(locale, "how.title")}>
  <h2 class="text-center text-2xl font-extrabold tracking-tight text-slate-900 md:text-3xl dark:text-white">
    {t(locale, "how.title")}
  </h2>
  <ol class="mt-8 grid gap-4 md:grid-cols-3">
    {steps.map((s) => (
      <li class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900">
        <span class="inline-flex h-9 w-9 items-center justify-center rounded-full bg-teal-600 text-sm font-extrabold text-white">
          {s.n}
        </span>
        <h3 class="mt-3 font-bold text-slate-900 dark:text-white">{s.t}</h3>
        <p class="mt-1.5 text-sm leading-relaxed text-slate-600 dark:text-slate-300">{s.d}</p>
      </li>
    ))}
  </ol>
</section>
