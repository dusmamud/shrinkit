---
import { t } from "../lib/i18n";
import type { Locale } from "../lib/locale";

interface Props {
  locale: Locale;
  idPrefix?: string;
}

const { locale, idPrefix = "desktop" } = Astro.props;

const lightLabel = t(locale, "theme.light");
const darkLabel = t(locale, "theme.dark");
---

<div class="custom-dropdown relative inline-block text-left" data-dropdown="theme" data-prefix={idPrefix}>
  <button
    type="button"
    class="dropdown-trigger inline-flex h-9 items-center gap-1.5 rounded-[6px] border border-tdivider bg-tsurface px-2.5 py-1.5 text-xs font-medium text-tink shadow-sm transition hover:border-taccent focus:outline-none focus-visible:ring-2 focus-visible:ring-taccent"
    aria-haspopup="listbox"
    aria-expanded="false"
    aria-label={t(locale, "theme.choose")}
  >
    {/* Sun Icon for Light */}
    <svg
      class="theme-icon-light h-3.5 w-3.5 text-amber-500"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <circle cx="12" cy="12" r="4"></circle>
      <path d="M12 2v2"></path>
      <path d="M12 20v2"></path>
      <path d="m4.93 4.93 1.41 1.41"></path>
      <path d="m17.66 17.66 1.41 1.41"></path>
      <path d="M2 12h2"></path>
      <path d="M20 12h2"></path>
      <path d="m6.34 17.66-1.41 1.41"></path>
      <path d="m19.07 4.93-1.41 1.41"></path>
    </svg>

    {/* Moon Icon for Dark */}
    <svg
      class="theme-icon-dark hidden h-3.5 w-3.5 text-indigo-400"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
    </svg>

    <span class="theme-current-label tracking-wide">{lightLabel}</span>

    <svg
      class="dropdown-chevron h-3 w-3 text-tink/50 transition-transform duration-200"
      viewBox="0 0 16 16"
      fill="none"
      aria-hidden="true"
    >
      <path d="m4 6 4 4 4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </button>

  <div
    class:list={[
      "dropdown-menu absolute right-0 z-[80] hidden w-36 rounded-lg border border-tdivider bg-tsurface p-1 shadow-lg ring-1 ring-black/5 backdrop-blur-sm",
      // In the mobile drawer the switcher sits at the bottom, so the menu
      // opens upward — opening downward gets clipped by the drawer's
      // overflow-y-auto container.
      idPrefix === "mobile"
        ? "bottom-full mb-1.5 origin-bottom-right"
        : "top-full mt-1.5 origin-top-right",
    ]}
    role="listbox"
    aria-label={t(locale, "theme.choose")}
  >
    {/* Light Option */}
    <button
      type="button"
      role="option"
      data-theme-option="light"
      class="theme-option-btn flex w-full items-center justify-between rounded-[5px] px-2.5 py-1.5 text-xs text-tink transition-colors hover:bg-thoverbg"
    >
      <span class="flex items-center gap-2">
        <svg class="h-3.5 w-3.5 text-amber-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2"></path>
          <path d="M12 20v2"></path>
          <path d="m4.93 4.93 1.41 1.41"></path>
          <path d="m17.66 17.66 1.41 1.41"></path>
          <path d="M2 12h2"></path>
          <path d="M20 12h2"></path>
          <path d="m6.34 17.66-1.41 1.41"></path>
          <path d="m19.07 4.93-1.41 1.41"></path>
        </svg>
        <span>{lightLabel}</span>
      </span>
      <svg class="theme-check-icon hidden h-3.5 w-3.5 text-tbtnb" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path d="M3 8.5l3.5 3.5 6.5-7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </button>

    {/* Dark Option */}
    <button
      type="button"
      role="option"
      data-theme-option="dark"
      class="theme-option-btn flex w-full items-center justify-between rounded-[5px] px-2.5 py-1.5 text-xs text-tink transition-colors hover:bg-thoverbg"
    >
      <span class="flex items-center gap-2">
        <svg class="h-3.5 w-3.5 text-indigo-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
        </svg>
        <span>{darkLabel}</span>
      </span>
      <svg class="theme-check-icon hidden h-3.5 w-3.5 text-tbtnb" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path d="M3 8.5l3.5 3.5 6.5-7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </button>
  </div>

  {/* Hidden native select for test automation & compatibility */}
  <select
    data-testid="theme-select"
    class="sr-only pointer-events-none absolute -left-[9999px] -top-[9999px] h-0 w-0 opacity-0"
    tabindex="-1"
    aria-hidden="true"
  >
    <option value="light">{lightLabel}</option>
    <option value="dark">{darkLabel}</option>
    <option value="system">{t(locale, "theme.system")}</option>
  </select>
</div>
