---
import { t } from "../lib/i18n";
import { localizedPath, type Locale } from "../lib/locale";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

const links = [
  { href: localizedPath("/", locale), label: t(locale, "nav.tool") },
  { href: localizedPath("/privacy", locale), label: t(locale, "nav.privacy") },
  { href: localizedPath("/about", locale), label: t(locale, "nav.about") },
  { href: localizedPath("/contact", locale), label: t(locale, "nav.contact") },
];
---

<footer class="mt-20 border-t border-slate-200 dark:border-slate-800">
  <div class="mx-auto max-w-6xl px-4 py-10">
    <div class="flex flex-col items-start justify-between gap-6 md:flex-row md:items-center">
      <div>
        <p class="text-sm font-bold text-slate-900 dark:text-white">{t(locale, "site.name")}</p>
        <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">{t(locale, "footer.tagline")}</p>
        <p class="mt-1 text-xs text-teal-700 dark:text-teal-300">{t(locale, "footer.made")}</p>
      </div>
      <nav class="flex flex-wrap gap-x-6 gap-y-2" aria-label="Footer">
        {links.map((l) => (
          <a
            href={l.href}
            class="text-sm text-slate-500 transition hover:text-teal-700 dark:text-slate-400 dark:hover:text-teal-300"
          >
            {l.label}
          </a>
        ))}
      </nav>
    </div>
    <p class="mt-8 border-t border-slate-100 pt-6 text-xs text-slate-400 dark:border-slate-800 dark:text-slate-500">
      {t(locale, "footer.rights")}
    </p>
  </div>
</footer>
