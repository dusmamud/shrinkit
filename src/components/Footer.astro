---
import { t } from "../lib/i18n";
import { localizedPath, type Locale } from "../lib/locale";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

const home = localizedPath("/", locale);
const year = new Date().getFullYear();

const columns = [
  {
    heading: t(locale, "footer.col_privacy"),
    links: [{ href: localizedPath("/privacy", locale), label: t(locale, "footer.privacy_policy") }],
  },
  {
    heading: t(locale, "footer.col_reachout"),
    links: [{ href: localizedPath("/contact", locale), label: t(locale, "footer.contact_us") }],
  },
  {
    heading: t(locale, "footer.col_product"),
    links: [
      { href: `${home}#how-it-works`, label: t(locale, "footer.how_it_works") },
      { href: `${home}#tool`, label: t(locale, "footer.resize_image") },
    ],
  },
];
---

<footer class="mt-0 bg-[#f6faff] pt-[3em]">
  <div class="mx-auto max-w-[1075px] px-4 pb-10">
    <div class="flex flex-col gap-10 md:flex-row md:justify-between">
      <div class="max-w-xs">
        <a href={home} class="flex items-center gap-2.5" aria-label={t(locale, "site.name")}>
          <svg width="30" height="30" viewBox="0 0 34 34" aria-hidden="true">
            <rect width="34" height="34" rx="7" fill="#007bff"></rect>
            <path
              d="M11 23V11h12"
              stroke="#fff"
              stroke-width="2.6"
              stroke-linecap="round"
              stroke-linejoin="round"
              fill="none"></path>
            <path d="M11 11l9.5 9.5" stroke="#fff" stroke-width="2.6" stroke-linecap="round"></path>
            <path
              d="M15.5 20.5h5v-5"
              stroke="#fff"
              stroke-width="2.6"
              stroke-linecap="round"
              stroke-linejoin="round"
              fill="none"></path>
          </svg>
          <span class="text-lg font-medium tracking-tight text-black">ShrinkIt</span>
        </a>
        <p class="mt-3 text-[0.875rem] font-light leading-relaxed text-black">
          {t(locale, "footer.tagline")}
        </p>
      </div>
      <div class="flex flex-col gap-8 sm:flex-row sm:gap-16">
        {
          columns.map((col) => (
            <div>
              <h3 class="text-[0.875rem] font-medium text-black">{col.heading}</h3>
              <ul class="mt-3 space-y-2.5">
                {col.links.map((l) => (
                  <li>
                    <a
                      href={l.href}
                      class="text-[0.875rem] font-light text-black transition-colors hover:text-[#016df0]"
                    >
                      {l.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </div>
  <div class="bg-[#016df0]">
    <p class="mx-auto max-w-[1075px] px-4 py-3 text-center text-sm font-normal text-white">
      {t(locale, "footer.rights", { year })}
    </p>
  </div>
</footer>
