---
import { t } from "../lib/i18n";
import { localizedPath, type Locale } from "../lib/locale";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

const home = localizedPath("/", locale);
const year = new Date().getFullYear();

const columns = [
  {
    heading: t(locale, "footer.col_tools"),
    links: [
      { href: "/tools", label: t(locale, "footer.tools_all") },
      { href: "/tools/compress-to-50kb", label: t(locale, "footer.tools_50kb") },
      { href: "/tools/compress-to-20kb", label: t(locale, "footer.tools_20kb") },
      { href: "/tools/passport-photo-maker", label: t(locale, "footer.tools_passport") },
      { href: "/tools/social-media-resizer", label: t(locale, "footer.tools_social") },
      { href: "/tools/compare-images", label: t(locale, "footer.tools_compare") },
    ],
  },
  {
    heading: t(locale, "footer.col_product"),
    links: [
      { href: `${home}#how-it-works`, label: t(locale, "footer.how_it_works") },
      { href: `${home}#tool`, label: t(locale, "footer.resize_image") },
    ],
  },
  {
    heading: t(locale, "footer.col_privacy"),
    links: [
      { href: localizedPath("/privacy", locale), label: t(locale, "footer.privacy_policy") },
      { href: localizedPath("/terms", locale), label: t(locale, "footer.terms") },
    ],
  },
  {
    heading: t(locale, "footer.col_reachout"),
    links: [{ href: localizedPath("/contact", locale), label: t(locale, "footer.contact_us") }],
  },
];
---

<footer class="mt-0 bg-tsurface2 pt-[3em]">
  <div class="mx-auto max-w-[1075px] px-4 pb-10">
    <div class="flex flex-col gap-10 md:flex-row md:justify-between">
      <div class="max-w-xs">
        <a href={home} class="flex items-center gap-2.5" aria-label={t(locale, "site.name")}>
          <img
            src="/favicon.svg"
            alt="ShrinkIt"
            width="30"
            height="30"
            class="h-[30px] w-[30px] object-contain"
          />
          <span class="text-lg font-medium tracking-tight text-tink">ShrinkIt</span>
        </a>
        <p class="mt-3 text-[0.875rem] font-light leading-relaxed text-tink">
          {t(locale, "footer.tagline")}
        </p>
      </div>
      <div class="flex flex-col gap-8 sm:flex-row sm:gap-16">
        {
          columns.map((col) => (
            <div>
              <h3 class="text-[0.875rem] font-medium text-tink">{col.heading}</h3>
              <ul class="mt-3 space-y-2.5">
                {col.links.map((l) => (
                  <li>
                    <a
                      href={l.href}
                      class="text-[0.875rem] font-light text-tink transition-colors hover:text-taccent"
                    >
                      {l.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </div>
  <div class="bg-[#016df0]">
    <p class="mx-auto max-w-[1075px] px-4 py-3 text-center text-sm font-normal text-white">
      {t(locale, "footer.rights", { year })}
    </p>
  </div>
</footer>
