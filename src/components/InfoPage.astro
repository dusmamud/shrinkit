---
import { t } from "../lib/i18n";
import type { Locale } from "../lib/locale";

interface Section {
  title: string;
  body: string;
}

interface Props {
  locale: Locale;
  title: string;
  intro?: string;
  sections?: Section[];
  contactEmail?: string;
}

const { locale, title, intro, sections, contactEmail } = Astro.props;
---

<div class="mx-auto max-w-3xl px-4 py-14">
  <h1 class="text-3xl font-extrabold tracking-tight text-slate-900 md:text-4xl dark:text-white">
    {title}
  </h1>
  {intro && (
    <p class="mt-4 leading-relaxed text-slate-600 dark:text-slate-300">{intro}</p>
  )}
  {sections && (
    <div class="mt-8 space-y-8">
      {sections.map((s) => (
        <section>
          <h2 class="text-lg font-bold text-slate-900 dark:text-white">{s.title}</h2>
          <p class="mt-2 text-sm leading-relaxed text-slate-600 dark:text-slate-300">{s.body}</p>
        </section>
      ))}
    </div>
  )}
  {contactEmail && (
    <p class="mt-8 rounded-2xl border border-teal-200 bg-teal-50 px-5 py-4 text-sm text-teal-900 dark:border-teal-800 dark:bg-teal-950/50 dark:text-teal-100">
      {t(locale, "contact.email_label")}{" "}
      <a href={`mailto:${contactEmail}`} class="font-semibold underline underline-offset-2">
        {contactEmail}
      </a>
    </p>
  )}
  <slot />
</div>
