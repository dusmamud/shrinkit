---
import { t } from "../lib/i18n";
import type { Locale } from "../lib/locale";

interface Section {
  title: string;
  body: string;
}

interface Props {
  locale: Locale;
  title: string;
  intro?: string;
  sections?: Section[];
  contactEmail?: string;
}

const { locale, title, intro, sections, contactEmail } = Astro.props;
---

<div class="bg-[#fafcff]">
  <div class="mx-auto max-w-3xl px-4 py-14">
    <h1 class="text-[2.5rem] font-normal tracking-tight text-black">{title}</h1>
    {intro && (
      <p class="mt-4 text-[1.0625rem] font-light leading-relaxed text-[#1d2939]">{intro}</p>
    )}
    {sections && (
      <div class="mt-8 space-y-8">
        {sections.map((s) => (
          <section class="rounded-[6px] border border-[#d7dee9] bg-white p-6">
            <h2 class="text-lg font-medium text-black">{s.title}</h2>
            <p class="mt-2 text-[1.0625rem] font-light leading-relaxed text-[#1d2939]">{s.body}</p>
          </section>
        ))}
      </div>
    )}
    {contactEmail && (
      <p class="mt-8 rounded-[6px] border border-[#52a0ff] bg-white px-5 py-4 text-sm font-light text-[#1d2939]">
        {t(locale, "contact.email_label")}{" "}
        <a
          href={`mailto:${contactEmail}`}
          class="font-normal text-[#016df0] underline underline-offset-2 hover:text-[#0257bf]"
        >
          {contactEmail}
        </a>
      </p>
    )}
    <slot />
  </div>
</div>
