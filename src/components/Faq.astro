---
import { t } from "../lib/i18n";
import type { Locale } from "../lib/locale";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

const faqs = [
  { q: t(locale, "faq.q1"), a: t(locale, "faq.a1") },
  { q: t(locale, "faq.q2"), a: t(locale, "faq.a2") },
  { q: t(locale, "faq.q3"), a: t(locale, "faq.a3") },
  { q: t(locale, "faq.q4"), a: t(locale, "faq.a4") },
  { q: t(locale, "faq.q5"), a: t(locale, "faq.a5") },
];

// FAQPage structured data for SEO.
const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---

<section class="mx-auto max-w-3xl px-4 py-14" aria-label={t(locale, "faq.title")}>
  <h2 class="text-center text-2xl font-extrabold tracking-tight text-slate-900 md:text-3xl dark:text-white">
    {t(locale, "faq.title")}
  </h2>
  <div class="mt-8 space-y-3">
    {faqs.map((f) => (
      <details class="group rounded-2xl border border-slate-200 bg-white px-5 py-4 shadow-sm open:shadow dark:border-slate-800 dark:bg-slate-900">
        <summary class="flex cursor-pointer items-center justify-between gap-4 font-semibold text-slate-900 marker:hidden dark:text-white">
          {f.q}
          <svg
            class="h-5 w-5 shrink-0 text-teal-600 transition-transform group-open:rotate-180"
            viewBox="0 0 20 20"
            fill="none"
            aria-hidden="true"
          >
            <path d="m5 7.5 5 5 5-5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </summary>
        <p class="mt-3 text-sm leading-relaxed text-slate-600 dark:text-slate-300">{f.a}</p>
      </details>
    ))}
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
</section>
