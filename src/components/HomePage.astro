---
import { t } from "../lib/i18n";
import type { Locale } from "../lib/locale";
import ShrinkItApp from "./react/ShrinkItApp";
import InfoSections from "./InfoSections.astro";

import ToolsShowcase from "./home/ToolsShowcase.astro";
import HowItWorks from "./home/HowItWorks.astro";
import ZeroUploadGuarantee from "./home/ZeroUploadGuarantee.astro";
import ComparisonTable from "./home/ComparisonTable.astro";
import FormatPresets from "./home/FormatPresets.astro";
import FaqSection from "./home/FaqSection.astro";
import HomeCta from "./home/HomeCta.astro";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
---

<section class="bg-tpage pt-6 sm:pt-8 md:pt-10 pb-4 sm:pb-6">
  <div class="mx-auto max-w-3xl px-4 text-center">
    <h1 class="text-3xl sm:text-4xl md:text-[2.75rem] font-bold tracking-tight text-tink leading-tight">
      {t(locale, "hero.title")}
    </h1>
    <p class="mt-2 text-xs sm:text-sm md:text-base text-tmuted font-normal leading-relaxed">
      {t(locale, "site.tagline")} — 100% private in-browser, zero uploads.
    </p>
  </div>
</section>

<section id="tool" class="scroll-mt-4 bg-tpage pb-10 sm:pb-14" aria-label={t(locale, "nav.resize")}>
  <ShrinkItApp client:load locale={locale} />
</section>

<ToolsShowcase locale={locale} />

<HowItWorks locale={locale} />

<ZeroUploadGuarantee locale={locale} />

<InfoSections locale={locale} />

<ComparisonTable locale={locale} />

<FormatPresets locale={locale} />

<FaqSection locale={locale} />

<HomeCta locale={locale} />
