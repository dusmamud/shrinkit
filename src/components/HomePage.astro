---
import { t } from "../lib/i18n";
import type { Locale } from "../lib/locale";
import ShrinkItApp from "./react/ShrinkItApp";
import InfoSections from "./InfoSections.astro";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
---

<section class="bg-white">
  <div class="mx-auto max-w-[1075px] px-4 pb-10 pt-14 md:pt-20">
    <h2 class="text-center text-[3.125rem] font-normal leading-tight text-black">
      {t(locale, "hero.title")}
    </h2>
  </div>
</section>

<section id="tool" class="scroll-mt-6 bg-white pb-14" aria-label={t(locale, "nav.resize")}>
  <ShrinkItApp client:load locale={locale} />
</section>

<InfoSections locale={locale} />
