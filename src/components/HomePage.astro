---
import type { Locale } from "../lib/locale";
import { t } from "../lib/i18n";

import HeroSection from "./home/HeroSection.astro";
import HowItWorks from "./home/HowItWorks.astro";
import ToolsShowcase from "./home/ToolsShowcase.astro";
import ZeroUploadGuarantee from "./home/ZeroUploadGuarantee.astro";
import ComparisonTable from "./home/ComparisonTable.astro";
import FaqSection from "./home/FaqSection.astro";
import HomeCta from "./home/HomeCta.astro";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
---

<script
  type="application/ld+json"
  set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Organization",
        "@id": "https://dusrel.com/#organization",
        name: "Dusrel",
        url: "https://dusrel.com/",
        logo: "https://dusrel.com/logo.png",
        sameAs: [
          "https://x.com/dusrel",
          "https://www.instagram.com/dusrel",
          "https://www.facebook.com/dusrel",
          "https://www.youtube.com/@dusrel",
          "https://www.linkedin.com/company/dusrel",
        ],
      },
      {
        "@type": "WebSite",
        "@id": "https://shrinkit.dusrel.com/#website",
        url: "https://shrinkit.dusrel.com/",
        name: t(locale, "site.name"),
        description: t(locale, "site.description"),
        inLanguage: locale,
        publisher: { "@id": "https://dusrel.com/#organization" },
      },
      {
        "@type": "WebApplication",
        "@id": "https://shrinkit.dusrel.com/#app",
        name: t(locale, "site.name"),
        url: "https://shrinkit.dusrel.com/",
        applicationCategory: "MultimediaApplication",
        operatingSystem: "Any",
        inLanguage: locale,
        offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
        description: t(locale, "site.description"),
        featureList:
          "Resize images by pixels, percent, cm or inches; compress to an exact size such as 50KB or 20KB; convert JPG, PNG, GIF and WebP; open HEIC/HEIF and AVIF; batch processing; all metadata removed; 100% on-device, no uploads",
        publisher: { "@id": "https://dusrel.com/#organization" },
        isPartOf: { "@id": "https://shrinkit.dusrel.com/#website" },
      },
    ],
  })}
/>

<HeroSection locale={locale} />

<HowItWorks locale={locale} />

<ToolsShowcase locale={locale} />

<ZeroUploadGuarantee locale={locale} />

<ComparisonTable locale={locale} />

<FaqSection locale={locale} />

<HomeCta locale={locale} />
