---
import { t } from "../lib/i18n";
import type { Locale } from "../lib/locale";
import ShrinkItApp from "./react/ShrinkItApp";
import HowItWorks from "./HowItWorks.astro";
import Features from "./Features.astro";
import Faq from "./Faq.astro";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
---

<section class="hero-dots relative overflow-hidden">
  <div class="mx-auto max-w-5xl px-4 pb-10 pt-14 text-center md:pt-20">
    <p class="mx-auto inline-flex items-center gap-2 rounded-full border border-teal-200 bg-teal-50 px-4 py-1.5 text-xs font-semibold text-teal-800 dark:border-teal-800 dark:bg-teal-950/60 dark:text-teal-200">
      <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path d="M8 1.5 9.7 5.6 14 6.3 10.8 9.4 11.6 13.7 8 11.5 4.4 13.7 5.2 9.4 2 6.3 6.3 5.6 8 1.5Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
      </svg>
      {t(locale, "hero.badge")}
    </p>
    <h1 class="mx-auto mt-5 max-w-3xl text-4xl font-extrabold tracking-tight text-slate-900 md:text-5xl dark:text-white">
      {t(locale, "hero.title")}
    </h1>
    <p class="mx-auto mt-4 max-w-2xl text-base text-slate-600 md:text-lg dark:text-slate-300">
      {t(locale, "hero.subtitle")}
    </p>
  </div>
</section>

<section class="pb-4" aria-label={t(locale, "nav.tool")}>
  <ShrinkItApp client:load locale={locale} />
</section>

<HowItWorks locale={locale} />
<Features locale={locale} />
<Faq locale={locale} />
