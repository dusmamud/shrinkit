---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout locale="en" path="/404" title="Page not found — ShrinkIt">
  <div class="mx-auto max-w-xl px-4 py-24 text-center">
    <p class="text-6xl font-extrabold text-teal-600">404</p>
    <h1 class="mt-4 text-2xl font-bold text-slate-900 dark:text-white">Page not found</h1>
    <p class="mt-2 text-slate-600 dark:text-slate-300">
      The page you are looking for does not exist.
    </p>
    <a
      href="/"
      class="mt-6 inline-block rounded-full bg-teal-600 px-6 py-2.5 text-sm font-semibold text-white hover:bg-teal-700"
    >
      Back to the image resizer
    </a>
  </div>
</BaseLayout>
