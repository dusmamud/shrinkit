---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout locale="en" path="/404" title="Page not found — ShrinkIt">
  <div class="mx-auto max-w-xl bg-white px-4 py-24 text-center">
    <p class="text-6xl font-medium text-[#007bff]">404</p>
    <h1 class="mt-4 text-2xl font-normal text-black">Page not found</h1>
    <p class="mt-2 font-light text-[#1d2939]">
      The page you are looking for does not exist.
    </p>
    <a
      href="/"
      class="mt-6 inline-block rounded-[6px] bg-[#007bff] px-6 py-2.5 text-sm font-bold text-white transition hover:bg-[#0257bf]"
    >
      Back to the image resizer
    </a>
  </div>
</BaseLayout>
