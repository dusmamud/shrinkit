---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PassportPhotoApp from "../../tools/passport/PassportPhotoApp";

const locale = "en" as const;
const title = "Passport Photo Maker Online Free (35x45mm & 2x2 inch) — ShrinkIt";
const description =
  "Generate official compliant passport and visa photos online in seconds. Pre-set dimensions for India, USA, UK, and Schengen visas with 300 DPI resolution.";
---

<BaseLayout locale={locale} path="/tools/passport-photo-maker" title={title} description={description} image="/og-passport-photo-maker.png">
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebApplication",
      name: "Passport & Visa Photo Maker Online Free",
      url: "https://shrinkit.dusrel.com/tools/passport-photo-maker",
      applicationCategory: "MultimediaApplication",
      operatingSystem: "Any",
      offers: {
        "@type": "Offer",
        price: "0",
        priceCurrency: "USD",
      },
      description: description,
      featureList:
        "Passport photo 35x45 mm, 2x2 inch visa photo, India passport photo, US visa photo, 300 DPI generator, pure white background",
    })}
  />
  <div class="min-h-[80vh] py-8">
    <PassportPhotoApp client:load />
  </div>
</BaseLayout>
