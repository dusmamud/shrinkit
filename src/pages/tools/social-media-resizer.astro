---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SocialResizerApp from "../../tools/social/SocialResizerApp";

const locale = "en" as const;
const title = "Social Media Image Resizer Online Free (Instagram, YouTube, X) — ShrinkIt";
const description =
  "Easily resize images for Instagram, YouTube thumbnails, TikTok, Twitter/X, and LinkedIn online with zero quality loss and no server uploads. 100% private.";
---

<BaseLayout locale={locale} path="/tools/social-media-resizer" title={title} description={description}>
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebApplication",
      name: "Social Media Image Resizer Online Free",
      url: "https://shrinkit.pages.dev/tools/social-media-resizer",
      applicationCategory: "MultimediaApplication",
      operatingSystem: "Any",
      offers: {
        "@type": "Offer",
        price: "0",
        priceCurrency: "USD",
      },
      description: description,
      featureList:
        "Instagram square 1080x1080, Instagram story 1080x1920, YouTube thumbnail 1280x720, Twitter post, LinkedIn banner resizer",
    })}
  />
  <div class="min-h-[80vh] py-8">
    <SocialResizerApp client:load />
  </div>
</BaseLayout>
