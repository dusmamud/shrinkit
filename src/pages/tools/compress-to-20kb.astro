---
import BaseLayout from "../../layouts/BaseLayout.astro";
import TargetSizeApp from "../../tools/target-size/TargetSizeApp";

const locale = "en" as const;
const title = "Compress Signature & Photo to 20KB Online Free — 100% Private";
const description =
  "Reduce signature and photo size strictly under 20KB for online government exam submissions, SSC, banking, and university admissions. Completely in-browser.";
---

<BaseLayout locale={locale} path="/tools/compress-to-20kb" title={title} description={description} image="/og-compress-to-20kb.png">
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebApplication",
      name: "Compress Signature & Photo to 20KB",
      url: "https://shrinkit.dusrel.com/tools/compress-to-20kb",
      applicationCategory: "MultimediaApplication",
      operatingSystem: "Any",
      offers: {
        "@type": "Offer",
        price: "0",
        priceCurrency: "USD",
      },
      description: description,
      featureList:
        "Compress signature to 20KB, SSC signature resizer, UPSC signature resize, 100% private in-browser",
    })}
  />
  <div class="min-h-[80vh] py-8">
    <TargetSizeApp
      client:load
      initialTargetKb={20}
      title="Compress Signature & Photo to 20KB"
      subtitle="Strictly below 20 KB limit for SSC, UPSC, and online job portal signature uploads. Zero server upload."
      enableBlackWhite
    />
  </div>
</BaseLayout>
