---
import BaseLayout from "../../layouts/BaseLayout.astro";
import LegalPage from "../../components/LegalPage.astro";
import { privacyDoc } from "../../content/legal/privacy";
import { locales, type Locale } from "../../lib/locales";

export function getStaticPaths() {
  return locales
    .filter((l): l is Exclude<Locale, "en"> => l !== "en")
    .map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
---

<BaseLayout
  locale={locale}
  path="/privacy"
  title="Privacy Policy — ShrinkIt"
  description="How ShrinkIt handles your images and your information: everything runs in your browser, nothing is uploaded, and the site keeps almost nothing."
  image="/og-privacy.png"
>
  <LegalPage
    doc={privacyDoc}
    notice="This document is provided in English. The English version governs."
  />
</BaseLayout>
