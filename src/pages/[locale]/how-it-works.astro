---
import BaseLayout from "../../layouts/BaseLayout.astro";
import HowItWorks from "../../components/home/HowItWorks.astro";
import HomeCta from "../../components/home/HomeCta.astro";
import { t } from "../../lib/i18n";
import { locales, type Locale } from "../../lib/locales";

export function getStaticPaths() {
  return locales
    .filter((l): l is Exclude<Locale, "en"> => l !== "en")
    .map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
---

<BaseLayout
  locale={locale}
  path="/how-it-works"
  title={`${t(locale, "nav.how")} — ${t(locale, "site.name")}`}
  description={t(locale, "how.description")}
>
  <HowItWorks locale={locale} />
  <HomeCta locale={locale} />
</BaseLayout>
