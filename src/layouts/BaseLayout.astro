---
import "../styles/global.css";
import { t } from "../lib/i18n";
import { alternates, localizedPath, type Locale } from "../lib/locale";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  locale: Locale;
  /** Path without locale prefix, e.g. "/" or "/privacy". */
  path: string;
  title?: string;
  description?: string;
  /** OG image path, e.g. "/og-image.png". Defaults to the landing OG image. */
  image?: string;
  /** Render only the copyright bar in the footer (used by the clean /resize page). */
  minimalFooter?: boolean;
}

const { locale, path, minimalFooter = false } = Astro.props;

const site = (Astro.site ?? new URL("https://shrinkit.dusrel.com")).toString().replace(/\/$/, "");
const title = Astro.props.title ?? `${t(locale, "site.name")} — ${t(locale, "site.tagline")}`;
const description = Astro.props.description ?? t(locale, "site.description");
const canonical = `${site}${localizedPath(path, locale)}`;
const ogImage = `${site}${Astro.props.image ?? "/og-image.png"}`;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#007bff" data-theme-color />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#121214" data-theme-color />
    <script is:inline>
      try {
        var stored = localStorage.getItem("shrinkit-theme");
        var theme = stored === "light" || stored === "dark" ? stored : "system";
        var dark =
          theme === "dark" ||
          (theme === "system" && window.matchMedia("(prefers-color-scheme: dark)").matches);
        var resolved = dark ? "dark" : "light";
        document.documentElement.dataset.theme = resolved;
        document.documentElement.style.colorScheme = resolved;
        var color = dark ? "#121214" : "#007bff";
        document.querySelectorAll("meta[data-theme-color]").forEach(function (meta) {
          meta.setAttribute("content", color);
        });
      } catch (e) {}
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternates(site, path).map((a) => (
      <link rel="alternate" hreflang={a.locale} href={a.href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={`${site}${path}`} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={t(locale, "site.name")} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  </head>
  <body class="bg-tpage text-tink2 flex min-h-dvh flex-col">
    <Header locale={locale} path={path} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer locale={locale} minimal={minimalFooter} />
    <script is:inline>
      if ("serviceWorker" in navigator) {
        if (location.hostname === "localhost" || location.hostname === "127.0.0.1") {
          navigator.serviceWorker.getRegistrations().then(function (registrations) {
            for (var reg of registrations) {
              reg.unregister();
            }
          });
          if ("caches" in window) {
            caches.keys().then(function (names) {
              for (var name of names) caches.delete(name);
            });
          }
        } else {
          window.addEventListener("load", function () {
            navigator.serviceWorker.register("/sw.js").catch(function () {});
          });
        }
      }
    </script>
  </body>
</html>
