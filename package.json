{
  "dependencies": {
    "@astrojs/react": "^7.0.1",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/inter": "^5.3.0",
    "@inlang/paraglide-js": "^2.26.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.8",
    "exifr": "^7.1.3",
    "gifenc": "^1.0.3",
    "jszip": "^3.10.1",
    "pica": "^9.0.1",
    "piexifjs": "^1.0.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3"
  },
  "description": "ShrinkIt — free, private, client-side image resizer & compressor (Astro + React + Cloudflare Pages)",
  "devDependencies": {
    "@eslint/js": "^9.24.0",
    "@inlang/plugin-message-format": "^3.2.1",
    "@playwright/test": "^1.52.0",
    "eslint": "^9.24.0",
    "prettier": "^3.5.3",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.29.0",
    "vitest": "^3.1.3"
  },
  "name": "shrinkit",
  "private": true,
  "scripts": {
    "build": "npm run paraglide && astro build",
    "dev": "astro dev",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "eslint .",
    "paraglide": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide",
    "preview": "astro preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "type": "module",
  "version": "1.0.0"
}
